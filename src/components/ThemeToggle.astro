<div>
  <button
    id="theme-toggle-selector"
    aria-label="Cambiar tema"
    class="w-9 h-9 flex items-center justify-center rounded-full border border-gray-200 dark:border-gray-600 text-custom-blue-dark dark:text-custom-yellow-chrome hover:bg-gray-100 dark:hover:bg-gray-700/50 hover:text-custom-blue transition-colors"
  >
  </button>
  <script>
    const themeToggleSelector = document.getElementById(
      "theme-toggle-selector"
    );
    if (themeToggleSelector) {
      themeToggleSelector.addEventListener("click", () => {
        const isDark = document.documentElement.classList.contains("dark");
        setTheme(isDark ? "light" : "dark");
      });
    }

    // El tema ya se aplica antes del primer pintado (script inline en Layout.astro
    // head) para evitar el flash de contenido sin estilo. Aquí solo sincronizamos
    // el icono con la clase "dark" ya presente en <html>.
    const initialTheme = document.documentElement.classList.contains("dark")
      ? "dark"
      : "light";
    setIcon(initialTheme);

    function setTheme(newTheme: string) {
      document.documentElement.classList.toggle("dark", newTheme === "dark");
      localStorage.setItem("theme", newTheme);
      setIcon(newTheme);
    }

    function setIcon(newTheme: string) {
      const lightIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-sun transition-transform duration-300 hover:scale-110">
  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
  <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0" />
  <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7" />
</svg>`;
      const darkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
      fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-moon transition-transform duration-300 hover:scale-110">
  <path stroke="none" d="M0 0h24v24H0z" fill="none" />
  <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z" />
</svg>`;
      const icon = newTheme === "light" ? darkIcon : lightIcon;
      if (themeToggleSelector) themeToggleSelector.innerHTML = icon;
    }
  </script>
</div>
