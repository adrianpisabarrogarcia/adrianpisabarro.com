---
// Importa los iconos necesarios
import JSIcon from "./icons/js.astro";
import AstroIcon from "./icons/astro.astro";
import AngularIcon from "./icons/angular.astro";
import TailwindIcon from "./icons/tailwind.astro";
import BootstrapIcon from "./icons/bootstrap.astro";
import TypescriptIcon from "./icons/typescript.astro";
import SpringIcon from "./icons/spring.astro";
import FastAPIIcon from "./icons/fastapi.astro";
import LaravelIcon from "./icons/laravel.astro";
import SlimIcon from "./icons/php.astro";
import StrapiIcon from "./icons/strapi.astro";
import DirectusIcon from "./icons/directus.astro";
import StripeIcon from "./icons/stripe.astro";
import OracleIcon from "./icons/oracle.astro";
import MongoDBIcon from "./icons/mongodb.astro";
import FirebaseIcon from "./icons/firebase.astro";
import MySQLIcon from "./icons/mysql.astro";
import TursoIcon from "./icons/turso.astro";
import S3Icon from "./icons/s3.astro";
import DockerIcon from "./icons/docker.astro";
import KubernetesIcon from "./icons/kubernetes.astro";
import JenkinsIcon from "./icons/jenkins.astro";
import GitLabCIIcon from "./icons/gitlab-ci.astro";
import OpenShiftIcon from "./icons/openshift.astro";
import VMWareTanzuIcon from "./icons/tanzu.astro";
import RancherIcon from "./icons/rancher.astro";
import VercelIcon from "./icons/vercel.astro";
import GcpIcon from "./icons/gcp.astro";
import VpsIcon from "./icons/vps.astro";
const categories = [
  {
    name: "Frontend",
    technologies: [
      {
        name: "JavaScript",
        icon: JSIcon,
      },
      {
        name: "Typescript",
        icon: TypescriptIcon,
      },
      {
        name: "Astro",
        icon: AstroIcon,
      },
      {
        name: "Angular",
        icon: AngularIcon,
      },
      {
        name: "Tailwind",
        icon: TailwindIcon,
      },
      {
        name: "Bootstrap",
        icon: BootstrapIcon,
      },
    ],
  },
  {
    name: "Backend",
    technologies: [
      {
        name: "Spring Boot (Java)",
        icon: SpringIcon,
      },
      {
        name: "FastAPI (Python)",
        icon: FastAPIIcon,
      },
      {
        name: "Laravel (PHP)",
        icon: LaravelIcon,
      },
      {
        name: "Slim (PHP)",
        icon: SlimIcon,
      },
      {
        name: "Strapi",
        icon: StrapiIcon,
      },
      {
        name: "Directus",
        icon: DirectusIcon,
      },
      {
        name: "Stripe",
        icon: StripeIcon,
      },
    ],
  },
  {
    name: "Data",
    technologies: [
      {
        name: "Oracle",
        icon: OracleIcon,
      },
      {
        name: "MongoDB",
        icon: MongoDBIcon,
      },
      {
        name: "Firebase",
        icon: FirebaseIcon,
      },
      {
        name: "MySQL",
        icon: MySQLIcon,
      },
      {
        name: "S3",
        icon: S3Icon,
      },
      {
        name: "Turso",
        icon: TursoIcon,
      },
    ],
  },
  {
    name: "DevOps",
    technologies: [
      {
        name: "Docker",
        icon: DockerIcon,
      },
      {
        name: "Kubernetes",
        icon: KubernetesIcon,
      },
      {
        name: "Jenkins",
        icon: JenkinsIcon,
      },
      {
        name: "GitLab CI",
        icon: GitLabCIIcon,
      },
      {
        name: "OpenShift",
        icon: OpenShiftIcon,
      },
      {
        name: "VMWare Tanzu",
        icon: VMWareTanzuIcon,
      },
      {
        name: "Rancher",
        icon: RancherIcon,
      },
      {
        name: "Vercel",
        icon: VercelIcon,
      },
      {
        name: "GCP",
        icon: GcpIcon,
      },
      {
        name: "VPS",
        icon: VpsIcon,
      },
    ],
  },
];
---

<section class="sm:mt-20 mt-10">
  <h2 class="flex items-center text-3xl font-semibold">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="40"
      height="40"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-terminal-2 pr-1"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M8 9l3 3l-3 3"></path><path d="M13 15h3"></path><path
        d="M3 4m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2H5a2 2 0 0 1 -2 -2z"
      ></path></svg
    >
    Tecnologías
  </h2>
  <div>
    {
      categories.map((category) => (
        <article>
          <h3 class="text-xl font-semibold mt-5">{category.name}</h3>
          <div class="mt-2 flex flex-row flex-wrap">
            {category.technologies.map((tech) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700/50 px-3 py-1 text-sm font-medium text-gray-700 dark:text-gray-200 me-2 mb-2">
                <span class="flex text-custom-blue-dark dark:text-custom-yellow-chrome">
                  <tech.icon />
                </span>
                {tech.name}
              </span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>
