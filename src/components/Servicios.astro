---
const services = [
  {
    title: "Desarrollo web a medida",
    description:
      "Webs, aplicaciones y MVPs a medida, eligiendo en cada caso las herramientas más adecuadas. De la idea al despliegue en producción.",
    icon: "code",
  },
  {
    title: "Consultoría de arquitectura",
    description:
      "Diseño de arquitectura de software, microservicios y microfrontales. Revisión técnica y planes de evolución para sistemas existentes.",
    icon: "building",
  },
  {
    title: "Auditorías técnicas y DevOps",
    description:
      "Revisión de código, CI/CD, contenedores y despliegues en Kubernetes. Detección de riesgos y mejoras de rendimiento y seguridad.",
    icon: "shield-check",
  },
  {
    title: "Integración de IA",
    description:
      "Soluciones de IA aplicadas a procesos de negocio: automatización, generación de informes y asistentes a medida.",
    icon: "bulb",
  },
];
---

<section id="servicios" class="sm:mt-20 mt-10 scroll-mt-20">
  <h2 class="flex items-center text-3xl font-semibold">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="40"
      height="40"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-briefcase-2 pr-1"
      ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
        d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"
      ></path><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"></path><path
        d="M12 12l0 .01"></path><path d="M3 13a20 20 0 0 0 18 0"></path>
    </svg>
    En qué puedo ayudarte
  </h2>
  <p class="mt-3 leading-relaxed">
    Compagino mi puesto como Software Architect en CaixaBank Tech con algunas
    colaboraciones externas. Si tu proyecto encaja en alguna de estas áreas,
    <a href="/#contacto" class="text-custom-blue hover:underline font-medium">hablemos</a>.
  </p>
  <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      services.map((service) => (
        <article class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50/60 dark:bg-gray-700/20 hover:border-custom-blue/40 dark:hover:border-custom-blue/40 transition-all duration-300">
          <div class="flex items-center gap-2 text-custom-blue-dark dark:text-custom-yellow-chrome">
            {service.icon === "code" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M7 8l-4 4l4 4" />
                <path d="M17 8l4 4l-4 4" />
                <path d="M14 4l-4 16" />
              </svg>
            )}
            {service.icon === "building" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 21l18 0" />
                <path d="M9 8l1 0" />
                <path d="M9 12l1 0" />
                <path d="M9 16l1 0" />
                <path d="M14 8l1 0" />
                <path d="M14 12l1 0" />
                <path d="M14 16l1 0" />
                <path d="M5 21v-16a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v16" />
              </svg>
            )}
            {service.icon === "shield-check" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1 -8.5 15a12 12 0 0 1 -8.5 -15a12 12 0 0 0 8.5 -3" />
                <path d="M9 12l2 2l4 -4" />
              </svg>
            )}
            {service.icon === "bulb" && (
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                <path d="M3 12h1m8 -9v1m8 8h1m-15.4 -6.4l.7 .7m12.1 -.7l-.7 .7" />
                <path d="M9 16a5 5 0 1 1 6 0a3.5 3.5 0 0 0 -1 3a2 2 0 0 1 -4 0a3.5 3.5 0 0 0 -1 -3" />
                <path d="M9.7 17l4.6 0" />
              </svg>
            )}
            <h3 class="text-lg font-semibold">{service.title}</h3>
          </div>
          <p class="mt-2 text-sm leading-relaxed">{service.description}</p>
        </article>
      ))
    }
  </div>
</section>
