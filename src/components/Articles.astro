---
import { getCollection } from "astro:content";

interface Props {
  limit?: number;
  showFilter?: boolean;
}

const { limit, showFilter = false } = Astro.props;

const allBlogPosts = await getCollection("blog");
allBlogPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
allBlogPosts.forEach((post: any) => {
  post.formattedDate = formatDate(post.data.date);
});

const displayedPosts = limit ? allBlogPosts.slice(0, limit) : allBlogPosts;

// Extraer categorías únicas
const categories = Array.from(
  new Set(allBlogPosts.map((post) => post.data.category))
).filter(Boolean);

function formatDate(date: string | Date) {
  const d = new Date(date);
  const month = d.toLocaleString("es-ES", { month: "long" });
  return `${month.charAt(0).toUpperCase() + month.slice(1)} ${d.getFullYear()}`;
}
---

<section id="articulos" class="sm:mt-20 mt-10 scroll-mt-20">
  <h2 class="flex items-center text-3xl font-semibold">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="40"
      height="40"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="icon icon-tabler icons-tabler-outline icon-tabler-pencil pr-1"
    >
      <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
      <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4"></path>
      <path d="M13.5 6.5l4 4"></path>
    </svg>
    {limit ? "Últimos artículos" : "Artículos y Publicaciones"}
  </h2>

  {
    showFilter && (
      <div class="mt-4 mb-4 flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
        <!-- Buscador -->
        <div class="relative w-full sm:w-72">
          <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-gray-400">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
          </div>
          <input
            type="text"
            id="article-search-input"
            placeholder="Buscar artículos..."
            class="w-full pl-9 pr-4 py-2 text-sm rounded-xl border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-custom-blue transition-all"
          />
        </div>

        <!-- Filtros por Categoría -->
        <div class="flex flex-wrap gap-2" id="category-filter-buttons">
          <button
            data-category="all"
            class="category-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium bg-custom-blue-dark text-white dark:bg-custom-yellow-chrome dark:text-gray-900 transition-colors cursor-pointer"
          >
            Todas ({allBlogPosts.length})
          </button>
          {categories.map((cat) => {
            const count = allBlogPosts.filter(
              (p) => p.data.category === cat
            ).length;
            return (
              <button
                data-category={cat}
                class="category-btn px-3 py-1.5 rounded-full text-xs font-mono font-medium bg-gray-200 dark:bg-gray-700/60 text-gray-700 dark:text-gray-300 hover:bg-gray-300 dark:hover:bg-gray-600 transition-colors cursor-pointer"
              >
                {cat} ({count})
              </button>
            );
          })}
        </div>
      </div>
    )
  }

  <div id="articles-list">
    {
      displayedPosts.map((post: any) => (
        <a
          class="article-card p-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/30 card-hover-effect hover:border-custom-blue/50 dark:hover:border-custom-yellow-chrome/50 hover:bg-white dark:hover:bg-gray-700/50 flex items-center gap-3 mt-3"
          href={`/blog/${post.slug}`}
          aria-label={post.data.title}
          data-category={post.data.category}
          data-title={post.data.title.toLowerCase()}
          data-description={(post.data.description || "").toLowerCase()}
        >
          <div class="w-1/10 min-w-16">
            <img
              src={post.data.image.src}
              alt={post.data.image.alt}
              class="w-16 h-16 object-cover rounded-lg"
            />
          </div>
          <div class="w-9/10">
            <h3 class="text-xl font-medium">{post.data.title}</h3>
            <p class="text-gray-600 dark:text-gray-300 text-sm font-mono">
              <span class="font-bold">{post.formattedDate}</span> ·{" "}
              <span class="text-custom-blue-dark dark:text-custom-yellow-chrome font-medium">
                {post.data.category}
              </span>
            </p>
          </div>
        </a>
      ))
    }
  </div>

  <div
    id="no-articles-found"
    class="hidden p-6 mt-4 text-center border border-dashed border-gray-300 dark:border-gray-700 rounded-xl text-gray-500 dark:text-gray-400"
  >
    No se encontraron artículos que coincidan con la búsqueda.
  </div>

  {
    limit && (
      <div class="mt-4">
        <a
          href="/articulos"
          class="inline-flex items-center gap-1 rounded-full bg-gray-100 dark:bg-gray-700/50 border border-gray-200 dark:border-gray-600 text-custom-blue-dark dark:text-custom-yellow-chrome px-4 py-2 text-sm font-medium hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors duration-300"
          aria-label="Ver todos los artículos"
        >
          Ver todos los artículos ({allBlogPosts.length}) →
        </a>
      </div>
    )
  }
</section>

{
  showFilter && (
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        const searchInput = document.getElementById("article-search-input");
        const buttons = document.querySelectorAll(
          "#category-filter-buttons .category-btn"
        );
        const articles = document.querySelectorAll(
          "#articles-list .article-card"
        );
        const noResults = document.getElementById("no-articles-found");

        let activeCategory = "all";
        let searchQuery = "";

        function filterArticles() {
          let visibleCount = 0;

          articles.forEach((art) => {
            const articleCat = art.getAttribute("data-category");
            const title = art.getAttribute("data-title") || "";
            const description = art.getAttribute("data-description") || "";

            const matchesCategory =
              activeCategory === "all" || articleCat === activeCategory;
            const matchesSearch =
              !searchQuery ||
              title.includes(searchQuery) ||
              description.includes(searchQuery);

            if (matchesCategory && matchesSearch) {
              art.style.display = "flex";
              visibleCount++;
            } else {
              art.style.display = "none";
            }
          });

          if (noResults) {
            if (visibleCount === 0) {
              noResults.classList.remove("hidden");
            } else {
              noResults.classList.add("hidden");
            }
          }
        }

        if (searchInput) {
          searchInput.addEventListener("input", (e) => {
            searchQuery = e.target.value.toLowerCase().trim();
            filterArticles();
          });
        }

        buttons.forEach((btn) => {
          btn.addEventListener("click", () => {
            activeCategory = btn.getAttribute("data-category");

            buttons.forEach((b) => {
              b.classList.remove(
                "bg-custom-blue-dark",
                "text-white",
                "dark:bg-custom-yellow-chrome",
                "dark:text-gray-900"
              );
              b.classList.add(
                "bg-gray-200",
                "dark:bg-gray-700/60",
                "text-gray-700",
                "dark:text-gray-300"
              );
            });

            btn.classList.remove(
              "bg-gray-200",
              "dark:bg-gray-700/60",
              "text-gray-700",
              "dark:text-gray-300"
            );
            btn.classList.add(
              "bg-custom-blue-dark",
              "text-white",
              "dark:bg-custom-yellow-chrome",
              "dark:text-gray-900"
            );

            filterArticles();
          });
        });
      });
    </script>
  )
}
