---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 Not found - Portfolio de Adrián Pisabarro">
  <main
    class="min-h-screen flex flex-col items-center justify-center text-center"
  >
    <h1 class="text-8xl font-bold font-pixel text-custom-blue tracking-widest">404</h1>
    <p class="text-xl mt-4 mb-8">Oops! Parece que esta página no existe 😢</p>
    <a
      href="/"
      class="text-lg font-mono font-medium text-custom-blue hover:underline"
    >
      Volver al inicio
    </a>
  </main>
</Layout>
